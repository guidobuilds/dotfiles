# Reemplaza TU_EMAIL con tu email noreply de GitHub antes de publicar.
# En GitHub → Settings → Emails → "Keep my email addresses private".
[user]
	name = Guido
	email = TU_EMAIL@users.noreply.github.com

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[color]
	ui = auto

[core]
	editor = nvim

[rerere]
	enabled = true
