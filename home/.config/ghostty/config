# Ghostty config — Guido's dotfiles

# Tema y tipografía
theme = catppuccin-mocha
font-family = "Fira Code"
font-size = 13
font-feature = "calt"

# Apariencia
window-padding-x = 8
window-padding-y = 8
background-opacity = 0.95
mouse-hide-while-typing = true
cursor-style = block
cursor-style-blink = false
copy-on-select = true

# macOS
macos-titlebar-style = hidden-inset
macos-option-as-alt = true

# Keybindings
keybind = ctrl+shift+enter=new-window
keybind = cmd+t=new-tab
keybind = cmd+d=new-split-right
keybind = cmd+shift+d=new-split-down
keybind = cmd+w=close_surface
keybind = cmd+enter=new-split-bottom
